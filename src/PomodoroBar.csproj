<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;Dev</Configurations>
    <Version>1.1.4</Version>
    <ApplicationIcon>../assets/PomodoroBar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF owns DPI awareness via the manifest; WinForms is only used for the tray. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Dev'">
    <ApplicationIcon>../assets/PomodoroBar.Dev.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DEV</DefineConstants>
    <InformationalVersion>$(Version)-dev</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Content Include="../sounds/*.wav" Link="sounds/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="../assets/PomodoroBar.ico" Link="PomodoroBar.ico" Condition="'$(Configuration)' != 'Dev'" />
    <Resource Include="../assets/PomodoroBar.Dev.ico" Link="PomodoroBar.ico" Condition="'$(Configuration)' == 'Dev'" />
    <InternalsVisibleTo Include="PomodoroBar.Tests" />
  </ItemGroup>
</Project>
